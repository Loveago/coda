DATABASE_URL="postgresql://user:password@host:5432/gacoda?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/gacoda?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: enables Vercel Blob storage for uploads (falls back to local disk)
BLOB_READ_WRITE_TOKEN=

# --- Admin credentials ---
# When set, the admin login automatically creates/updates this SUPER_ADMIN
# account so you can change credentials from the environment alone.
ADMIN_EMAIL="admin@demo.mrtruthagency.com"
ADMIN_PASSWORD="demo-admin-password"
ADMIN_NAME="Demo Administrator"

# --- Demo member credentials ---
# When set, the member login automatically creates/updates this demo member.
DEMO_MEMBER_EMAIL="member@demo.mrtruthagency.com"
DEMO_MEMBER_PASSWORD="demo-member-password"
DEMO_MEMBER_NAME="Kwame Mensah"
