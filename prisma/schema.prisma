generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(EDITOR)
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  articles     NewsArticle[]
  auditLogs    AuditLog[]
  createdCodes RegistrationCode[]
  workPayAuditLogs WorkPayAuditLog[]
}

model MembershipApplication {
  id               String           @id @default(uuid())
  fullName         String
  phone            String
  email            String?
  dateOfBirth      DateTime?
  platform         String?
  vehicleInfo      String?
  idReference      String?
  region           String?
  emergencyContact String?
  additionalInfo   String?
  consent          Boolean
  status           MembershipStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsCategory {
  id        String        @id @default(uuid())
  name      String        @unique
  slug      String        @unique
  articles  NewsArticle[]
  createdAt DateTime      @default(now())
}

model NewsArticle {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  coverImage     String?
  openGraphImage String?
  canonicalUrl   String?
  seoTitle       String?
  seoDescription String?
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       NewsCategory? @relation(fields: [categoryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, archived])
}

model Statistic {
  id           String   @id @default(uuid())
  label        String   @unique
  value        String
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(uuid())
  title        String
  caption      String?
  imageUrl     String
  altText      String
  category     String?
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Resource {
  id           String   @id @default(uuid())
  title        String
  description  String
  category     String
  fileUrl      String
  thumbnailUrl String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           String  @id @default(uuid())
  name         String
  position     String
  biography    String?
  imageUrl     String?
  socialLinks  Json?
  displayOrder Int     @default(0)
  active       Boolean @default(true)
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id           String  @id @default(uuid())
  label        String
  href         String
  displayOrder Int     @default(0)
  enabled      Boolean @default(true)
  system       Boolean @default(false)
}

model Media {
  id        String   @id @default(uuid())
  url       String   @unique
  altText   String?
  caption   String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  category    String
  imageUrl    String?
  features    Json?
  ctaLabel    String?
  ctaHref     String?
  displayOrder Int     @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id            String   @id @default(uuid())
  make          String
  model         String
  year          Int
  category      String
  transmission  String?
  fuelType      String?
  seats         Int?
  description   String?
  features      Json?
  price         Int?
  dailyRate     Int?
  availability  String   @default("AVAILABLE")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        VehicleImage[]
  inquiries     VehicleInquiry[]
  rentalInquiries RentalInquiry[]
  workPayAgreements WorkPayAgreement[]
  vehicleAssignments WorkPayVehicleAssignment[]

  @@index([category, availability])
}

model VehicleImage {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
}

model VehicleInquiry {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  name        String
  email       String
  phone       String?
  requestType String
  message     String?
  createdAt   DateTime @default(now())
  @@index([vehicleId, createdAt])
}

model RentalInquiry {
  id        String   @id @default(uuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  name      String
  email     String
  phone     String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id            String          @id @default(uuid())
  name          String
  sku           String           @unique
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  description   String?
  imageUrl      String?
  price         Int?
  stock         Int             @default(0)
  brand         String?
  compatibility Json?
  available     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model DriverOpportunity {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  requirements Json?
  benefits     Json?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  applications DriverApplication[]
}

model DriverApplication {
  id             String   @id @default(uuid())
  opportunityId  String
  opportunity    DriverOpportunity @relation(fields: [opportunityId], references: [id])
  fullName       String
  email          String
  phone          String
  experience     String?
  message        String?
  status         String   @default("NEW")
  internalNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RegistrationPaymentState {
  NOT_REQUIRED
  PENDING
  PAID
}

enum PaymentType {
  REGISTRATION_FEE
  ANNUAL_DUES
  WORK_APPLICATION_FEE
  WORK_PAY_INSTALLMENT
  WORK_PAY_DEPOSIT
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum MemberTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model Member {
  id                    String                   @id @default(uuid())
  memberNumber          String                   @unique
  email                 String                   @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String
  ghanaCardNumber       String?                  @unique
  dateOfBirth           DateTime?
  gender                String?
  location              String?
  platform              String?
  yearsExperience        Int?
  vehicleInfo            String?
  vehicleRegistration    String?
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelationship  String?
  emergency2Name         String?
  emergency2Phone        String?
  emergency2Relationship String?
  status                MemberStatus             @default(PENDING)
  emailVerified         Boolean                  @default(false)
  photoUrl              String?
  registrationPayment   RegistrationPaymentState @default(NOT_REQUIRED)
  membershipStartDate   DateTime?
  membershipEndDate     DateTime?
  internalNotes         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  payments              Payment[]
  tokens                MemberToken[]
  workApplications      WorkApplication[]
  workPayApplications   WorkPayApplication[]
  workPayAgreements     WorkPayAgreement[]
  workPayTickets        WorkPaySupportTicket[]
  registrationCodeId    String?
  registrationCode      RegistrationCode?        @relation(fields: [registrationCodeId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum WorkApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
}

// A member's job application. Submission is gated on the (optional)
// work application fee, mirroring the membership application flow.
model WorkApplication {
  id              String                @id @default(uuid())
  memberId        String
  member          Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position        String
  employmentType  String                @default("FULL_TIME")
  contactPhone    String?
  region          String?
  licenceClass    String?
  licenceNumber   String?
  licenceExpiry   DateTime?
  experienceYears Int?
  platforms       String?
  cvUrl           String?
  coverNote       String?
  consent         Boolean               @default(false)
  paymentState    RegistrationPaymentState @default(PENDING)
  status          WorkApplicationStatus @default(NEW)
  internalNotes   String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  payments        Payment[]

  @@index([status])
  @@index([memberId])
  @@index([createdAt])
}

model Payment {
  id                    String        @id @default(uuid())
  memberId              String
  member                Member        @relation(fields: [memberId], references: [id])
  workApplicationId     String?
  workApplication       WorkApplication? @relation(fields: [workApplicationId], references: [id], onDelete: SetNull)
  type                  PaymentType
  amount                Int
  currency              String        @default("GHS")
  reference             String        @unique
  provider              String        @default("paystack")
  providerTransactionId String?
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([memberId])
  @@index([status])
}

model FeeSetting {
  key             String   @id
  amount          Int
  enabled         Boolean  @default(true)
  currency        String   @default("GHS")
  gracePeriodDays Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model FeeSettingHistory {
  id              String   @id @default(uuid())
  feeKey          String
  previousAmount  Int?
  newAmount       Int
  enabled         Boolean
  currency        String   @default("GHS")
  gracePeriodDays Int      @default(0)
  changedBy       String
  note            String?
  createdAt       DateTime @default(now())

  @@index([feeKey])
}

model MemberToken {
  id        String          @id @default(uuid())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id])
  tokenHash String          @unique
  type      MemberTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([memberId, type])
}

model RegistrationCode {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  members     Member[]

  @@index([code])
  @@index([active])
}

enum WorkPayApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  WAITLISTED
  AGREEMENT_PENDING
  ACTIVE
  COMPLETED
  TERMINATED
  DEFAULTED
}

enum WorkPayAgreementStatus {
  PENDING_SIGNATURE
  ACTIVE
  IN_ARREARS
  DEFAULTED
  SUSPENDED
  COMPLETED
  OWNERSHIP_TRANSFERRED
  CANCELLED
}

enum WorkPayInstallmentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
}

enum WorkPayPaymentMethod {
  PAYSTACK_MOMO
  PAYSTACK_CARD
  CASH_OFFLINE
  BANK_TRANSFER
}

enum WorkPayDepositStatus {
  PENDING
  HELD
  PARTIALLY_DEDUCTED
  FULLY_DEDUCTED
  REFUNDED
}

enum WorkPayTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WorkPayTransferStatus {
  PENDING_CLEARANCE
  PAPERS_SUBMITTED
  DVLA_PROCESSING
  COMPLETED
}

model WorkPayApplication {
  id                    String                   @id @default(uuid())
  applicationNumber     String                   @unique
  memberId              String?
  member                Member?                  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fullName              String
  phone                 String
  email                 String
  ghanaCardNumber       String
  driverLicenseNumber   String
  driverLicenseClass    String
  driverLicenseExpiry   DateTime?
  yearsExperience       Int
  commercialHistory     String?
  rideHailingPlatforms  String?
  preferredVehicleType  String
  operatingRegion       String
  guarantor1Name        String
  guarantor1Phone       String
  guarantor1Occupation  String
  guarantor1Address     String
  guarantor1GhanaCard   String
  guarantor2Name        String
  guarantor2Phone       String
  guarantor2Occupation  String
  guarantor2Address     String
  guarantor2GhanaCard   String
  driverLicenseFrontUrl String?
  driverLicenseBackUrl  String?
  ghanaCardFrontUrl     String?
  proofOfResidenceUrl   String?
  utilityBillUrl        String?
  status                WorkPayApplicationStatus @default(SUBMITTED)
  interviewDate         DateTime?
  interviewNotes        String?
  interviewScore        Int?
  rejectionReason       String?
  internalNotes         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  agreements            WorkPayAgreement[]
  documents             WorkPayDocument[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([ghanaCardNumber])
}

model WorkPayAgreement {
  id                     String                        @id @default(uuid())
  agreementNumber        String                        @unique
  applicationId          String?
  application            WorkPayApplication?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  memberId               String?
  member                 Member?                       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  driverName             String
  driverPhone            String
  driverEmail            String?
  vehicleId              String
  vehicle                Vehicle                       @relation(fields: [vehicleId], references: [id])
  totalPrice             Decimal                       @db.Decimal(12, 2)
  depositRequired        Decimal                       @db.Decimal(12, 2)
  depositPaid            Decimal                       @default(0.00) @db.Decimal(12, 2)
  weeklyPayment          Decimal                       @db.Decimal(12, 2)
  durationWeeks          Int
  startDate              DateTime
  expectedCompletionDate DateTime
  actualCompletionDate   DateTime?
  gracePeriodDays        Int                           @default(3)
  latePenaltyFee         Decimal                       @default(50.00) @db.Decimal(12, 2)
  totalPaid              Decimal                       @default(0.00) @db.Decimal(12, 2)
  remainingBalance       Decimal                       @db.Decimal(12, 2)
  status                 WorkPayAgreementStatus        @default(PENDING_SIGNATURE)
  signedContractUrl      String?
  signedAt               DateTime?
  termsAndConditions     String?
  notes                  String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  vehicleAssignments     WorkPayVehicleAssignment[]
  installments           WorkPayInstallment[]
  payments               WorkPayPayment[]
  securityDeposits       WorkPaySecurityDeposit[]
  conditionReports       WorkPayVehicleConditionReport[]
  maintenanceRecords     WorkPayMaintenanceRecord[]
  documents              WorkPayDocument[]
  supportTickets         WorkPaySupportTicket[]
  ownershipTransfer      WorkPayOwnershipTransfer?
  auditLogs              WorkPayAuditLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([memberId])
}

model WorkPayVehicleAssignment {
  id                String           @id @default(uuid())
  agreementId       String
  agreement         WorkPayAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  handoverMileage   Int
  conditionNotes    String?
  handoverDate      DateTime         @default(now())
  handoverReportUrl String?
  returnDate        DateTime?
  returnMileage     Int?
  returnNotes       String?
  status            String           @default("ACTIVE")
  createdAt         DateTime         @default(now())

  @@index([agreementId])
  @@index([vehicleId])
}

model WorkPayInstallment {
  id               String                   @id @default(uuid())
  agreementId      String
  agreement        WorkPayAgreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  weekNumber       Int
  dueDate          DateTime
  targetAmount     Decimal                  @db.Decimal(12, 2)
  principalPortion Decimal                  @db.Decimal(12, 2)
  feePortion       Decimal                  @default(0.00) @db.Decimal(12, 2)
  amountPaid       Decimal                  @default(0.00) @db.Decimal(12, 2)
  status           WorkPayInstallmentStatus @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  allocations      WorkPayPaymentAllocation[]

  @@index([agreementId, weekNumber])
  @@index([status])
  @@index([dueDate])
}

model WorkPayPayment {
  id                    String                   @id @default(uuid())
  reference             String                   @unique
  agreementId           String
  agreement             WorkPayAgreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount                Decimal                  @db.Decimal(12, 2)
  paymentDate           DateTime                 @default(now())
  paymentMethod         WorkPayPaymentMethod
  paystackReference     String?
  paystackTransactionId String?
  channelDetails        String?
  verifiedBy            String?
  receiptNumber         String?
  notes                 String?
  status                String                   @default("SUCCESSFUL")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  allocations           WorkPayPaymentAllocation[]

  @@index([agreementId])
  @@index([reference])
  @@index([paymentDate])
}

model WorkPayPaymentAllocation {
  id               String             @id @default(uuid())
  paymentId        String
  payment          WorkPayPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId    String
  installment      WorkPayInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount           Decimal            @db.Decimal(12, 2)
  principalPortion Decimal            @db.Decimal(12, 2)
  feePortion       Decimal            @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime           @default(now())

  @@index([paymentId])
  @@index([installmentId])
}

model WorkPaySecurityDeposit {
  id              String               @id @default(uuid())
  agreementId     String
  agreement       WorkPayAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  targetAmount    Decimal              @db.Decimal(12, 2)
  amountPaid      Decimal              @default(0.00) @db.Decimal(12, 2)
  balance         Decimal              @default(0.00) @db.Decimal(12, 2)
  deductions      Decimal              @default(0.00) @db.Decimal(12, 2)
  deductionReason String?
  refundAmount    Decimal              @default(0.00) @db.Decimal(12, 2)
  refundDate      DateTime?
  status          WorkPayDepositStatus @default(PENDING)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([agreementId])
}

model WorkPayVehicleConditionReport {
  id             String           @id @default(uuid())
  agreementId    String
  agreement      WorkPayAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  reportType     String
  inspectionDate DateTime         @default(now())
  mileage        Int
  inspectorName  String
  checklist      Json?
  photos         Json?
  overallRating  String?
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([agreementId])
}

model WorkPayMaintenanceRecord {
  id                   String           @id @default(uuid())
  agreementId          String
  agreement            WorkPayAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  serviceType          String
  serviceDate          DateTime         @default(now())
  mileage              Int?
  cost                 Decimal          @default(0.00) @db.Decimal(12, 2)
  paidBy               String           @default("DRIVER")
  serviceCenter        String?
  receiptUrl           String?
  insuranceExpiryDate  DateTime?
  roadworthyExpiryDate DateTime?
  notes                String?
  status               String           @default("COMPLETED")
  createdAt            DateTime         @default(now())

  @@index([agreementId])
}

model WorkPayDocument {
  id            String              @id @default(uuid())
  agreementId   String?
  agreement     WorkPayAgreement?   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  applicationId String?
  application   WorkPayApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String
  title         String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  verified      Boolean             @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?
  createdAt     DateTime            @default(now())

  @@index([agreementId])
  @@index([applicationId])
}

model WorkPaySupportTicket {
  id            String              @id @default(uuid())
  ticketNumber  String              @unique
  agreementId   String?
  agreement     WorkPayAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  memberId      String
  member        Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category      String
  subject       String
  message       String
  priority      String              @default("NORMAL")
  status        WorkPayTicketStatus @default(OPEN)
  adminResponse String?
  respondedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([memberId])
  @@index([agreementId])
  @@index([status])
}

model WorkPayOwnershipTransfer {
  id                        String                @id @default(uuid())
  agreementId               String                @unique
  agreement                 WorkPayAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  transferCertificateNumber String                @unique
  finalPayoffVerified       Boolean               @default(false)
  payoffVerifiedAt          DateTime?
  payoffVerifiedBy          String?
  transferClearance         Boolean               @default(false)
  dvlaPaperworkStatus       WorkPayTransferStatus @default(PENDING_CLEARANCE)
  dvlaSubmissionDate        DateTime?
  dvlaCompletionDate        DateTime?
  handoverDate              DateTime?
  completionCertificateUrl  String?
  newRegistrationNumber     String?
  notes                     String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model WorkPayAuditLog {
  id             String            @id @default(uuid())
  agreementId    String?
  agreement      WorkPayAgreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  details        String
  previousValues Json?
  newValues      Json?
  ipAddress      String?
  createdAt      DateTime          @default(now())

  @@index([agreementId])
  @@index([userId])
}
